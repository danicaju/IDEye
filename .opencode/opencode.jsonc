{
  "$schema": "https://opencode.ai/config.json",
  // Project-local MCP server with IDEye-specific diagnostic and simulation tools.
  "mcp": {
    "servers": {
      "ideye-dev-tools": {
        "type": "local",
        "command": ["node", "tools/ideye-mcp/index.mjs"],
        "cwd": ".",
        "timeout": {
          "startup": 30000
        }
      }
    }
  }
}
